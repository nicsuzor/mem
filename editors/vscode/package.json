{
  "name": "mem-vscode",
  "displayName": "Mem PKB Language Server",
  "description": "VS Code extension backed by pkb lsp for previewing PKB references on mouseover and opening referenced files in a new tab",
  "version": "0.1.5",
  "publisher": "nicsuzor",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicsuzor/mem"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onStartupFinished",
    "onCommand:mem.showVersion",
    "onCommand:mem.showLogs",
    "onCommand:mem.restartServer",
    "onCommand:mem.openReference",
    "onCommand:mem.openReferenceAtCursor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "markdown.previewScripts": [
      "./media/preview.js"
    ],
    "commands": [
      {
        "command": "mem.openReference",
        "title": "Mem: Open PKB Reference in New Tab"
      },
      {
        "command": "mem.openReferenceAtCursor",
        "title": "Mem: Open Reference at Cursor in New Tab"
      },
      {
        "command": "mem.restartServer",
        "title": "Mem: Restart PKB LSP Server"
      },
      {
        "command": "mem.showVersion",
        "title": "Mem: Show PKB Version & Status"
      },
      {
        "command": "mem.showLogs",
        "title": "Mem: Show PKB LSP Logs"
      },
      {
        "command": "mem.dispatch",
        "title": "Mem: Dispatch PKB Task"
      }
    ],
    "semanticTokenTypes": [
      { "id": "pkbTaskReady", "description": "PKB ready task reference" },
      { "id": "pkbTaskDone", "description": "PKB completed task reference" },
      { "id": "pkbTaskBlocked", "description": "PKB blocked task reference" },
      { "id": "pkbTaskOther", "description": "PKB task reference in other state" },
      { "id": "pkbNodeInfo", "description": "PKB info/knowledge node reference" },
      { "id": "pkbNodeIndex", "description": "PKB index/topic node reference" },
      { "id": "pkbNodeChapter", "description": "PKB chapter/spec node reference" },
      { "id": "pkbNodeDefault", "description": "Default PKB node reference" }
    ],
    "semanticTokenModifiers": [
      { "id": "ready", "description": "Ready task state" },
      { "id": "done", "description": "Done task state" },
      { "id": "blocked", "description": "Blocked task state" },
      { "id": "inProgress", "description": "In-progress task state" },
      { "id": "task", "description": "Task node type" },
      { "id": "info", "description": "Info node type" },
      { "id": "index", "description": "Index node type" },
      { "id": "chapter", "description": "Chapter node type" }
    ],
    "semanticTokenScopes": [
      {
        "language": "markdown",
        "scopes": {
          "pkbTaskReady": ["markup.inserted", "entity.name.tag"],
          "pkbTaskDone": ["comment.line", "markup.strikethrough"],
          "pkbTaskBlocked": ["invalid.illegal", "markup.deleted"],
          "pkbTaskOther": ["entity.name.function"],
          "pkbNodeInfo": ["entity.name.type", "support.type"],
          "pkbNodeIndex": ["entity.name.section", "variable.other"],
          "pkbNodeChapter": ["keyword.control"]
        }
      }
    ],
    "configuration": {
      "title": "Mem PKB LSP",
      "properties": {
        "mem.lsp.executable": {
          "type": "string",
          "default": "pkb",
          "description": "Path to the pkb binary"
        },
        "mem.lsp.pkbRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the PKB root directory (defaults to workspace folder or ACA_DATA)"
        },
        "mem.lsp.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose debug logging in the Mem PKB LSP OutputChannel"
        },
        "mem.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the PKB language server"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runner.js",
    "bump": "node ./scripts/bump-version.js",
    "vscode:prepublish": "node ./scripts/bump-version.js && npm run compile",
    "package": "npx @vscode/vsce package",
    "install-extension": "npm run package && node ./scripts/install-extension.js"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^7.0.2"
  }
}
